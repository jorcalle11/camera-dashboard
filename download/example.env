# Copy to .env in your install directory and customize. NEVER commit .env.
#
# Quick start: https://github.com/jorcalle11/camera-dashboard/blob/main/download/README.md
# App images are always pulled as :latest from ghcr.io (see docker-compose.yml).

# --- Ports -------------------------------------------------------------------
WEB_UI_PORT=8080
NGINX_HTTP_PORT=80

GO2RTC_API_PORT=1984
GO2RTC_RTSP_PORT=8554
GO2RTC_WEBRTC_PORT=8555

SERVER_PORT=3000

# --- Storage (host paths) ----------------------------------------------------
RECORDINGS_LOCATION=./recordings
DATA_LOCATION=./data

RECORDINGS_CONTAINER_PATH=/recordings
DATA_CONTAINER_PATH=/data

# --- Camera streams (secrets — keep in .env only) -------------------------------
CAM1_RTSP_URL=ffmpeg:rtsps://username:password@192.168.68.107:322/stream0#video=copy#audio=copy
# CAM2_RTSP_URL=ffmpeg:rtsps://username:password@192.168.68.105:322/stream0#video=copy#audio=copy

HOST_IP=192.168.68.100

# --- Retention -----------------------------------------------------------------
DISK_FREE_THRESHOLD_GB=10
