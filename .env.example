# Copy to .env and fill in. NEVER commit .env.
# RTSPS URL for camera 1 (Wyze Cam v3, native RTSPS on port 322).
# NOTE: go2rtc's native RTSP client cannot negotiate with Wyze's RTSPS
# firmware (i/o timeout), so the source is wrapped with go2rtc's ffmpeg
# producer using stream copy (no transcoding).
CAM1_RTSP_URL=ffmpeg:rtsps://username:password@192.168.68.107:322/stream0#video=copy#audio=copy
# RTSPS URL for camera 2 (Wyze Cam v3, same format as camera 1)
CAM2_RTSP_URL=ffmpeg:rtsps://username:password@192.168.68.105:322/stream0#video=copy#audio=copy
# LAN IP of the machine running docker (used as WebRTC candidate)
HOST_IP=192.168.68.100

# Server recording paths (inside container these are /recordings and /data)
RECORDINGS_PATH=./recordings
DATA_PATH=./data

# Disk free threshold (GB). When free space drops below this, oldest segments are deleted.
DISK_FREE_THRESHOLD_GB=10
